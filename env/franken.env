# Caddy - Global Options
#CADDY_GLOBAL_OPTIONS=debug

SERVER_NAME=localhost

# Caddy - Extra config
CADDY_EXTRA_CONFIG=

# Franken worker - to switch in worker mode, set FRANKENPHP_WORKER_ENABLE to 1 and uncomment FRANKENPHP_CONFIG env
FRANKENPHP_WORKER_ENABLE=1
FRANKENPHP_CONFIG="
worker /var/www/pub/index.php
worker /var/www/pub/static.php
"
MAX_REQUESTS=10
